{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novel-training:anchor-v4.0.0:blind-score-record",
  "description": "v4.0.0 formal blind score record. Top-level keys are exactly id, rep, scores; scores contains the 19 indicators in fixed order. Scores are only 0, 5, or 10 and evidence/reason must be non-empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rep",
    "scores"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "rep": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "scores": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "prefixItems": [
        {
          "$ref": "#/$defs/B01"
        },
        {
          "$ref": "#/$defs/B02"
        },
        {
          "$ref": "#/$defs/B03"
        },
        {
          "$ref": "#/$defs/C01"
        },
        {
          "$ref": "#/$defs/B08"
        },
        {
          "$ref": "#/$defs/B09"
        },
        {
          "$ref": "#/$defs/B16"
        },
        {
          "$ref": "#/$defs/B23"
        },
        {
          "$ref": "#/$defs/B30"
        },
        {
          "$ref": "#/$defs/B34"
        },
        {
          "$ref": "#/$defs/B36"
        },
        {
          "$ref": "#/$defs/C22"
        },
        {
          "$ref": "#/$defs/N3"
        },
        {
          "$ref": "#/$defs/N6"
        },
        {
          "$ref": "#/$defs/B31"
        },
        {
          "$ref": "#/$defs/B33"
        },
        {
          "$ref": "#/$defs/C14"
        },
        {
          "$ref": "#/$defs/B18"
        },
        {
          "$ref": "#/$defs/N7"
        }
      ],
      "items": false
    }
  },
