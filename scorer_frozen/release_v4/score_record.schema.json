          "type": "string",
          "const": "B01 异常事件出现位置"
        },
        "score": {
          "type": "integer",
          "enum": [
            0,
            5,
            10
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
